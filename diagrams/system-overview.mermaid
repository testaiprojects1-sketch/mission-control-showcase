flowchart LR
    subgraph Client[Client Layer]
        UI[Next.js 15 Dashboard]
        BPMN[bpmn-js Editor]
        Viz[Three.js Viz]
        Collab[Yjs CRDT Sync]
    end
    subgraph Backend[Supabase Backend]
        Auth[Auth + RLS]
        Realtime[Realtime Server]
        Edge[Edge Functions]
        PG[(PostgreSQL + pgvector)]
        Storage[S3-compatible Storage]
    end
    subgraph Agents[Agent Runtime (Edge Functions)]
        Orch[Orchestrator]
        Research[Research Agent]
        Risk[Risk Agent]
        Comply[Compliance Agent]
    end
    subgraph Data[Data Layer]
        Market[Market Data APIs]
        News[News Feeds]
        Vector[pgvector Index]
        Cache[Redis]
    end
    subgraph Governance[Governance]
        Audit[Audit Logger]
        Eval[Eval Harness]
        Dashboard[Compliance Dashboard]
    end

    UI --> Auth
    UI --> Realtime
    BPMN --> Realtime
    BPMN --> Edge
    Viz --> PG
    Collab --> Realtime
    Edge --> Orch
    Orch --> Research
    Orch --> Risk
    Orch --> Comply
    Research --> Market
    Research --> News
    Research --> Vector
    Risk --> Market
    Comply --> PG
    Orch --> Audit
    Audit --> Dashboard
    Eval --> Audit

    style Client fill:#0B2D4A,color:#EC4899,stroke:#EC4899
    style Backend fill:#1A1A2E,color:#F472B6,stroke:#EC4899
    style Agents fill:#1A1A2E,color:#F472B6,stroke:#EC4899
    style Data fill:#F472B6,color:#0B2D4A,stroke:#EC4899
    style Governance fill:#EC4899,color:#fff,stroke:#F472B6